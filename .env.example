# ==============================================================================
# ANSTAT Environment Configuration Template
# ==============================================================================

# Google Tag Manager Container ID
# Supplied by GTM Admin (Format: GTM-XXXXXXX)
# Supports either VITE_GTM_ID (Vite standard) or NEXT_PUBLIC_GTM_ID (Next.js / cross-platform)
VITE_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Analytics 4 Measurement ID
# Supplied by GA4 Admin (Format: G-XXXXXXXXXX)
# Configured inside GTM container as a Google Tag
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional Contact Form API Endpoint (e.g. Formspree / Serverless Webhook)
# VITE_CONTACT_FORM_ENDPOINT=https://formspree.io/f/xxxxxx
